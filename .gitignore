# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env*.local
.env.vercel
# Allow .env.example to be committed
!.env.example

# not part of the web app (iOS project, design exports, planning docs, local agent config)
/NomLog-iOS/
/Nomlog_designs/
/Nomlog_ Your Daily Bites (2)/
*.xlsx
/.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
